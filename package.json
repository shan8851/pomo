{
  "name": "pomo",
  "version": "0.1.0",
  "description": "Keyboard-first Pomodoro TUI for the terminal.",
  "type": "module",
  "bin": {
    "pomo": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix"
  },
  "keywords": [
    "pomodoro",
    "tui",
    "productivity",
    "terminal"
  ],
  "license": "MIT",
  "dependencies": {
    "neo-blessed": "^0.2.0",
    "node-notifier": "^10.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "typescript": "^5.8.2",
    "tsx": "^4.19.3",
    "vitest": "^3.0.8"
  }
}
